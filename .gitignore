# Local Python environments and caches
.venv/
.venv-ai/
.runtime/
.ai-model-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# macOS metadata
.DS_Store

# Generated marking reports
marking/out/*.json
marking/out/*/
/auto_marking/test_runner/out/*
!/auto_marking/test_runner/out/.gitkeep

# Local build output and temporary files
node_modules/
node_modules.nosync/
dist/
*.tsbuildinfo
*.log
*.tmp

# Local database backups and SQLite working files
/backend/data/private/exams.sqlite3
/backend/data/private/*-before-*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Shared marking-lock browser verification output
/frontend/config/playwright/locking-test-results/

# Private SQLite snapshots and local process locks
/backend/data/private/backups/
*.runtime-lock

/frontend/recovery-test-results/

# Private account credentials and sessions must remain local
/backend/data/private/accounts.sqlite3

# Local database tooling and secrets
database/.env
database/backups/
database/local_tools/
database/dbeaver_workspace/
database/verification/
