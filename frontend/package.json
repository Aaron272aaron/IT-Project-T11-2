{
  "name": "automarktic-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run tests",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e config *.ts *.json index.html",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "test:e2e:sample": "playwright test --config config/playwright/sample.ts",
    "test:e2e:rubric": "playwright test --config config/playwright/rubric.ts",
    "test:e2e:runner": "playwright test --config config/playwright/runner.ts",
    "test:e2e:grouping": "playwright test --config config/playwright/grouping.ts",
    "test:e2e:auth": "playwright test --config config/playwright/auth.ts",
    "dev:frontend": "vite --host 127.0.0.1",
    "predev:frontend": "node scripts/prepare-pdf-assets.mjs",
    "test:e2e:preparation": "playwright test --config config/playwright/preparation.ts",
    "test:e2e:setup": "playwright test --config config/playwright/setup.ts"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.2.8",
    "diff": "^9.0.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
